<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Reminders.Mvc</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Serif:ital@0;1&display=swap">
        <link rel="stylesheet" href="~/css/site.css" />
    </head>

    <body>
        <header class="app-header">
            <div class="app-title-group">
                <a class="app-title" asp-controller="Reminders" asp-action="Index">Reminders</a>
                <span class="app-date">@DateTime.Today.ToString("dddd, MMMM d")</span>
            </div>

            <form class="search-pill" method="get" role="search" action="/">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8c8577" stroke-width="2.2" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" /><path d="M20 20l-4.2-4.2" />
                </svg>
                <input type="search" name="q" value="@ViewData["Query"]" placeholder="Search reminders" aria-label="Search reminders" />
                @if (ViewData["View"] is string view)
                {
                    <input type="hidden" name="view" value="@view" />
                }
            </form>

            <a class="btn-new" asp-controller="Reminders" asp-action="Create">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                <span>New<span class="btn-new-word">&nbsp;reminder</span></span>
            </a>
        </header>

        <main class="app-main">
            @RenderBody()
        </main>

    </body>

</html>
