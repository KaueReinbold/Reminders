# API Configuration
# Base URL for the Reminders API
# For local development with Docker Compose, use the nginx load balancer
NEXT_PUBLIC_API_BASE_URL=http://localhost:9999

# For production or GitHub Pages deployment, use your deployed API URL
# NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.com

# Demo mode: serve reminders from an in-browser mock instead of the API.
# Always on for the GitHub Pages build; set it to true to try the demo locally.
# NEXT_PUBLIC_MOCK_API=true
